# Copy to .env and fill in only what you use. Never commit .env.
# This agent is read-only: these keys are for search and optional summarization.
# They are not used to post, like, reply, follow, or send DMs.

# X (Twitter) recent search. Official API, app-only bearer token.
X_BEARER_TOKEN=

# YouTube Data API v3.
YOUTUBE_API_KEY=

# Web search provider: duckduckgo (default, no key), brave, or serper.
WEB_SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# Optional clustering. Any OpenAI-compatible chat endpoint.
# The raw mention list is always produced without this.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional CLIs. Leave empty to use the default command name on PATH.
AGENT_REACH_BIN=agent-reach
LAST30DAYS_BIN=last30days

# Override the HTTP User-Agent if you need to identify your own deployment.
SOCIAL_LISTEN_USER_AGENT=
